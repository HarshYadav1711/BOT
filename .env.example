DATABASE_URL=

# Optional SSL mode for server/scripts:
#   unset / default = verify certificates (recommended)
#   disable         = no TLS (local Postgres only)
#   no-verify       = TLS without cert verification (explicit opt-in only)
# DATABASE_SSL=

# Initial admin bootstrap (used only when admin_users is empty).
# Set these in Netlify env / local .env — do not commit real secrets.
ADMIN_INITIAL_USERNAME=
ADMIN_INITIAL_PASSWORD=
