DATABASE_URL=

# Optional SSL mode for server / Netlify Functions / local scripts:
#   unset / default = verify certificates (recommended when the host has a public CA chain)
#   disable         = no TLS (local Postgres only)
#   no-verify       = TLS without cert verification (explicit opt-in only;
#                     use when the provider presents a self-signed / private CA chain)
DATABASE_SSL=

# Initial admin bootstrap (used only when admin_users is empty).
# Set these in Netlify Site settings → Environment variables, and in local .env.
# Do not commit real secrets. Valid bootstrap credentials for this project:
#   ADMIN_INITIAL_USERNAME=admin
#   ADMIN_INITIAL_PASSWORD=<your password — must match the live admin password>
ADMIN_INITIAL_USERNAME=
ADMIN_INITIAL_PASSWORD=

# Optional cookie Secure flag override:
#   unset  = Secure on production / deploy-preview / branch-deploy / NETLIFY
#            (not on `netlify dev` / CONTEXT=dev)
#   true   = always Secure
#   false  = never Secure (local HTTP only)
# ADMIN_COOKIE_SECURE=
